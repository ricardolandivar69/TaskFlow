{
  "info": {
    "name": "TaskFlow - Practica Experimental 4",
    "description": "Coleccion de pruebas de TaskFlow (React + Express + MongoDB + JWT). Ejecutar en orden. No compartir los valores locales de token y contrasenas. Los registros y tokens solo se guardan en el entorno local de Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Salud de API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Aplicacion correcta\", () => pm.expect(pm.response.json().app).to.eql(\"TaskFlow\"));"
            ]
          }
        }
      ]
    },
